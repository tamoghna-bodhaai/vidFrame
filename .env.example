# vidFrame configuration. Copy to .env and adjust.

# OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, ...). Include /v1.
VIDFRAME_VLM_BASE_URL=http://localhost:8000/v1
VIDFRAME_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VIDFRAME_VLM_API_KEY=EMPTY

# openai = call the endpoint above; mock = deterministic offline provider for tests
VIDFRAME_VLM_MODE=openai

# Default provider shown in the UI: local (the endpoint above) or openrouter
VIDFRAME_VLM_PROVIDER=local

# OpenRouter (used when the job/UI selects the openrouter provider).
# The key stays server-side. OPENROUTER_API_KEY is also accepted.
VIDFRAME_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VIDFRAME_OPENROUTER_API_KEY=
VIDFRAME_OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct
VIDFRAME_OPENROUTER_REFERER=http://127.0.0.1:8000

# Multimodal providers. Set provider=openrouter to reuse the OpenRouter base URL and API key.
# Select models from OpenRouter's transcription and image-generation catalogs.
VIDFRAME_STT_PROVIDER=openrouter
VIDFRAME_STT_MODEL=mistralai/voxtral-small-transcribe-3-0
VIDFRAME_STT_TIMEOUT=600
VIDFRAME_STT_LANGUAGE=auto
VIDFRAME_STT_CHUNK_SECONDS=60
VIDFRAME_IMAGE_PROVIDER=openrouter
VIDFRAME_IMAGE_MODEL=
VIDFRAME_IMAGE_MAX_DIAGRAMS=8

# Optional separate model for the final report compilation pass
VIDFRAME_COMPILE_MODEL=

# Optional vision model for the diagram crop second pass.
# Empty = same model as the selected vision provider.
VIDFRAME_DIAGRAM_MODEL=

# Sampling and batching defaults
VIDFRAME_FPS=1.0
VIDFRAME_MAX_FRAMES=900
VIDFRAME_BATCH_SIZE=4
VIDFRAME_MAX_IMAGE_SIDE=768
VIDFRAME_JPEG_QUALITY=82

# Request/throughput tuning
VIDFRAME_REQUEST_TIMEOUT=180
VIDFRAME_MAX_CONCURRENCY=4
VIDFRAME_MAX_CONCURRENT_JOBS=1

# Storage
VIDFRAME_DATA_DIR=./data
VIDFRAME_MAX_UPLOAD_MB=4096
VIDFRAME_KEEP_SOURCE=true

# Compilation chunk size (characters)
VIDFRAME_COMPILE_CHUNK_CHARS=12000
